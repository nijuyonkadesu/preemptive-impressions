# ==========================================
# 1. REQUIRED CORE SETTINGS
# ==========================================
# Base URL for NextAuth authentication routing
NEXTAUTH_URL=http://localhost:3000/api/v1/auth

# Secret key for encrypting sessions (Generate a random string, e.g., via 'openssl rand -hex 32')
NEXTAUTH_SECRET=your_super_secret_random_string_here

# ==========================================
# 2. POSTGRES DATABASE SETTINGS
# ==========================================
# Must match the password expected by the postgres container
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ==========================================
# 3. TELEMETRY OPT-OUT
# ==========================================
NEXT_PUBLIC_DISABLE_TELEMETRY=true
MEILI_NO_ANALYTICS=true
